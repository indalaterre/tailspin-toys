---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <button
            type="button"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-game-filters"
          >
            Clear filters
          </button>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section
            aria-labelledby="game-filters-heading"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5"
            data-testid="game-filters"
          >
            <h3 id="game-filters-heading" class="mb-4 text-lg font-semibold text-slate-100">
              Filter games
            </h3>
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
              <fieldset class="min-w-0 flex-1">
                <legend class="mb-3 font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-x-5 gap-y-3">
                  {categories.map((category) => (
                    <label
                      for={`category-filter-${category.id}`}
                      class="inline-flex cursor-pointer items-center gap-2 text-slate-300"
                    >
                      <input
                        id={`category-filter-${category.id}`}
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="w-full sm:max-w-xs">
                <label for="publisher-filter" class="mb-3 block font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>
            </div>
            <p
              class="mt-4 text-sm text-slate-400"
              role="status"
              aria-live="polite"
              data-testid="game-filter-status"
            >
              Showing {games.length} games.
            </p>
          </section>

          <p
            class="mb-6 rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-300 hidden"
            data-testid="game-filter-empty"
            hidden
          >
            No games match those filters.
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="category"]'),
  );
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const gameCards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-testid="game-card"]'),
  );
  const status = document.querySelector<HTMLElement>('[data-testid="game-filter-status"]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-testid="game-filter-empty"]');
  const clearButton = document.querySelector<HTMLButtonElement>(
    '[data-testid="clear-game-filters"]',
  );

  /**
   * Filters pre-rendered cards using category OR matching and publisher AND matching,
   * then updates the live result count and empty-results message.
   */
  const applyFilters = (): void => {
    const selectedCategories = new Set(
      categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value),
    );
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const matchesCategory =
        selectedCategories.size === 0 ||
        selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const matchesPublisher =
        selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisherId;
      const isVisible = matchesCategory && matchesPublisher;

      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleCount++;
    }

    if (status) {
      status.textContent = `Showing ${visibleCount} of ${gameCards.length} games.`;
    }
    if (emptyMessage) {
      emptyMessage.classList.toggle('hidden', visibleCount !== 0);
      emptyMessage.hidden = visibleCount !== 0;
    }
  };

  for (const filter of categoryFilters) {
    filter.addEventListener('change', applyFilters);
  }
  publisherFilter?.addEventListener('change', applyFilters);
  clearButton?.addEventListener('click', () => {
    for (const filter of categoryFilters) filter.checked = false;
    if (publisherFilter) publisherFilter.value = '';
    applyFilters();
  });
</script>
